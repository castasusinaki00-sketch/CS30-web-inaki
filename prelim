            font-weight: 650;
            color: #465162;
            transition: color 150ms ease;
        }

        .nav-list a:hover {
            color: var(--ink);
        }

        /* =========================================================
            HERO
        ========================================================= */
        .hero {
            background: linear-gradient(135deg, #f7f8fa 0%, #ffffff 55%, #fff8e9 100%);
            padding: clamp(3.5rem, 8vw, 6.5rem) 0;
