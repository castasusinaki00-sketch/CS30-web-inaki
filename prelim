        /* =========================================================
            CTA SECTION
        ========================================================= */
        .cta-section {
            padding: clamp(3rem, 6vw, 5rem) 0;
            background: var(--surface);
        }

        .cta-box {
            background: var(--ink);
            color: var(--white);
            border-radius: 24px;
            padding: clamp(2.5rem, 5vw, 4.5rem);
