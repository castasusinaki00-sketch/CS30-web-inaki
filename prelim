        }

        /* =========================================================
            FRAMEWORK (INPUT - DEVELOPMENT - FINALIZATION)
        ========================================================= */
        .framework-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
            margin-top: 1.5rem;
        }

        .framework-card {
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 1.75rem;
            box-shadow: var(--shadow);
        }

        .stage-pill {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            padding: 0.3rem 0.65rem;
            border-radius: 999px;
            margin-bottom: 1rem;
        }

        .stage-input { background: #ede9fe; color: #5b21b6; }
        .stage-process { background: #fff2cd; color: #8a5a00; }
        .stage-output { background: #dcfce7; color: #166534; }

        .framework-card ul {
            padding-left: 1.2rem;
            margin: 0;
            color: var(--muted);
            font-size: 0.95rem;
        }

        .framework-card li {
            margin-bottom: 0.5rem;
        }

        /* =========================================================
            RESEARCH QUESTIONS (3-COLUMN GRID)
        ========================================================= */
        .grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
        }

        .rq-card {
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 1.75rem;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
        }

        .card-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            margin-bottom: 1.25rem;
            border-radius: 50%;
            background: #fff2cd;
            color: var(--accent-dark);
            font-weight: 850;
        }

        .rq-card p {
            margin: 0;
            color: var(--muted);
            font-size: 1rem;
        }

        /* =========================================================
            KEY FINDINGS & LIKERT METRICS
        ========================================================= */
        .findings {
            background: var(--surface);
        }

        .data-card {
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 1.75rem;
            box-shadow: 0 4px 15px rgba(23, 32, 51, 0.03);
        }

        .data-card h3 {
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--line);
            margin-bottom: 1rem;
        }

        .metric-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .metric-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.65rem 0;
            border-bottom: 1px dashed var(--line);
            font-size: 0.95rem;
        }

        .metric-item:last-child {
            border-bottom: none;
        }

        .score-badge {
            background: #fff2cd;
            color: var(--accent-dark);
            font-weight: 800;
            padding: 0.2rem 0.65rem;
            border-radius: 999px;
            font-size: 0.85rem;
        }

        .finding-subgroup {
            margin-top: 1rem;
        }

        .finding-subgroup h4 {
            font-size: 0.95rem;
            color: var(--accent-dark);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.25rem;
        }

        .finding-subgroup p {
            font-size: 0.9rem;
            color: var(--muted);
            margin-bottom: 0.85rem;
        }

        /* =========================================================
            QUALITATIVE THEMES (FLEX PILLS & CALLOUTS)
        ========================================================= */
        .pill-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.65rem;
            margin: 1.5rem 0 2.5rem 0;
            padding: 0;
            list-style: none;
        }

        .pill-list li {
            padding: 0.65rem 1.15rem;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: 999px;
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--ink);
            box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        }

        /* =========================================================
            SPLIT GRID: LIMITATIONS & RECOMMENDATIONS
        ========================================================= */
        .split-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .editorial-card {
            background: var(--surface);
            border-radius: var(--radius);
            padding: 2.25rem;
        }

        .editorial-card h3 {
            font-size: 1.35rem;
            margin-bottom: 1rem;
        }

        .editorial-card ul {
            margin: 0;
            padding-left: 1.25rem;
            color: var(--muted);
        }

        .editorial-card li {
            margin-bottom: 0.6rem;
