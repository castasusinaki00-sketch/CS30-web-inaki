        }

        /* =========================================================
            ACCESSIBILITY
        ========================================================= */
        .skip-link {
            position: absolute;
            top: -100px;
            left: 1rem;
            z-index: 999;
            padding: 0.75rem 1rem;
            background: var(--ink);
            color: var(--white);
            text-decoration: none;
            font-weight: 700;
            border-radius: 0 0 8px 8px;
            transition: top 0.2s ease;
        }

        .skip-link:focus {
            top: 0;
        }

        /* =========================================================
            LAYOUT & TYPOGRAPHY
        ========================================================= */
